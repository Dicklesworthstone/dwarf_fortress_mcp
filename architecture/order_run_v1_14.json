{
  "schema_version": "dfmcp.order-run/1.14",
  "status": "implemented_unadmitted_native_development",
  "protocol": {"major": 1, "minor": 14, "plugin": "dfmcp_order_run_v1_14", "package": "dfmcp.order_run.v1_14"},
  "methods": ["Handshake", "ObserveRun", "PrepareRun", "CommitRun", "QueryRun", "CancelRun"],
  "limits": {"game_ticks": [1, 1200], "wall_ms": [1, 60000], "preparation_seconds": 60, "records": 256,
    "stable_samples": [1, 16], "interval_ticks": [1, 1200], "complete_queue": 4096,
    "request_bytes": 2048, "capture_bytes": 573, "plan_bytes": 604, "record_bytes": 1425, "reply_bytes": 4096},
  "predicates": {"1": "approved", "2": "active", "3": "remaining_at_most"},
