  "identity": ["bridge_generation", "world_folder_utf8", "site_id", "dispatch_sequence", "game_tick", "native_order_id"],
  "hash_domains": {"plan": "dfmcp-order-run-plan/1", "token": "dfmcp-order-run-token/1", "record": "dfmcp-order-run-receipt/1"},
