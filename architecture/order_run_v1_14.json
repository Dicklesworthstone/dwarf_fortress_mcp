  "clock_phase_codes": {"0": "prepared", "1": "running", "2": "stopping", "3": "stopped", "4": "refused", "5": "source_lost"},
  "native_goal_sampling": true,
  "query_samples_or_dispatches": false,
  "unpause_retries": false,
  "absence_proves_completion": false,
  "predicate_proves_goods_produced": false,
  "hard_realtime_or_exact_tick_guarantee": false,
