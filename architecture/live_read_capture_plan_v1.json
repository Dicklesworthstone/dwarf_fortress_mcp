{
  "schema_version": "dfmcp.live-read-capture-plan/1",
  "status": "normative_agent_guidance",
  "output_contract": {
    "machine_output": "JSON object only",
    "command_representation": "argv array without shell interpolation",
    "secrets_in_arguments": false,
    "arbitrary_dfhack_commands": false,
    "arbitrary_lua": false,
    "mutation_authority": false
  },
  "cases": [
    {
      "gate": "R2",
      "case": "missing_token",
      "capture_kind": "probe",
      "automatable": false,
      "argv": ["cargo", "run", "--locked", "--quiet", "--bin", "dfmcp-live-probe", "--", "handshake-case", "missing_token"],
      "append_mode": "append-probe",
      "preconditions": ["DFHack remote server is reachable on numeric loopback", "the disposable DFHack process has no DFMCP_BRIDGE_TOKEN configured"],
      "operator_action": "restart only the disposable DF/DFHack fixture without DFMCP_BRIDGE_TOKEN, then run the probe"
    },
    {
      "gate": "R2",
      "case": "configured_token_short",
      "capture_kind": "probe",
      "automatable": false,
      "argv": ["cargo", "run", "--locked", "--quiet", "--bin", "dfmcp-live-probe", "--", "handshake-case", "configured_token_short"],
      "append_mode": "append-probe",
      "preconditions": ["the disposable DFHack process and probe environment carry the same 1..31-byte token"],
      "operator_action": "restart the disposable fixture with a 31-byte token and export the same token only in the probe process"
    },
    {
      "gate": "R2",
      "case": "configured_token_long",
      "capture_kind": "probe",
      "automatable": false,
      "argv": ["cargo", "run", "--locked", "--quiet", "--bin", "dfmcp-live-probe", "--", "handshake-case", "configured_token_long"],
      "append_mode": "append-probe",
      "preconditions": ["the disposable DFHack process and probe environment carry the same token longer than 256 bytes"],
      "operator_action": "restart the disposable fixture with a 257-byte token and export the same token only in the probe process"
    },
    {
      "gate": "R2",
      "case": "presented_token_short",
      "capture_kind": "probe",
      "automatable": true,
      "argv": ["cargo", "run", "--locked", "--quiet", "--bin", "dfmcp-live-probe", "--", "handshake-case", "presented_token_short"],
      "append_mode": "append-probe",
      "preconditions": ["the disposable DFHack process has a valid 32..256-byte token configured"],
      "operator_action": "none"
    },
    {
      "gate": "R2",
      "case": "presented_token_long",
