{
  "$comment": "Embedded query variant. Rust additionally validates native spatial/1.8 ID namespace, u64 range, duplicate citizen IDs across generations, ordered cuboids, total volume, observed map dimensions, exact capture and continuation binding. This is not source authority or a native mutation request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "citizens",
    "shelters"
  ],
  "properties": {
    "kind": {
      "const": "shelter_status"
    },
    "citizens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "generation"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[1-9][0-9]{0,19}$",
            "not": {
              "pattern": "[^0-9]"
            }
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        }
      }
    },
    "shelters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "min": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            }
          },
          "max": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            }
          }
        }
      }
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 128
    },
    "max_work": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 1000000
    },
    "continuation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "pattern": "^ss1:[1-9][0-9]*:[0-9a-f]{64}$",
      "not": {
        "type": "string",
        "pattern": "[^a-z0-9:]"
      }
    }
  }
}
