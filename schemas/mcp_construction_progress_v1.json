{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Furniture construction progress query over coherent spatial state",
  "description": "Read-only stage/link analysis and optional explicit watch proposals. Native IDs and expectations are not proof of an external placement receipt. Runtime additionally checks duplicate building/item targets, current authority, source/anchor, future deadline and sampling feasibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "targets"
  ],
  "properties": {
    "kind": {
      "const": "construction_progress"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "building_native_id"
        ],
        "properties": {
          "building_native_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483646
          },
          "expected_generation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            ]
          },
          "expected_type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "Bed",
                  "Chair",
                  "Table"
                ]
              }
            ]
          },
          "item_native_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483646
              }
            ]
          }
        }
      }
    },
    "limit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      ]
    },
    "continuation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^sp1:[1-9][0-9]*:[0-9a-f]{64}$",
          "not": {
            "pattern": "[^a-z0-9:]"
          }
        }
      ]
    },
    "max_work": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      ]
    },
    "monitor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key_prefix",
            "deadline_tick"
          ],
          "properties": {
            "key_prefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[A-Za-z0-9_.-]+$",
              "not": {
                "pattern": "[^A-Za-z0-9_.-]"
              }
            },
            "deadline_tick": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "poll_interval_ticks": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              ]
            },
            "stable_observations": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              ]
            }
          }
        }
      ]
    }
  }
}
