{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dfmcp:query:1",
  "title": "Structured canonical query envelope",
  "description": "Value of the query argument on protocol-1.1 fortress.query. Omit top-level mode/limit/continuation. Runtime additionally checks UTF-8 byte lengths, bounded shapes and work, unique metric names, group cardinality, exact anchors, authorization and complete response budgets. Capture/changes are bounded foreground endpoint comparisons, not background watchers or durable history.",
  "type": "object", "additionalProperties": false, "required": ["schema", "query"],
  "properties": {
    "schema": {"const": "dfmcp.query/1"},
    "expected_anchor": {"anyOf": [{"$ref": "#/$defs/anchor"}, {"type": "null"}]},
    "query": {"$ref": "#/$defs/query"}
  },
  "$defs": {
    "entity_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$", "description": "Canonical positive decimal u64; the runtime also checks numeric overflow."},
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\u0000]+$"},
    "spatial_coordinate": {"type":"array", "minItems":3, "maxItems":3, "items":{"type":"integer", "minimum":-2147483648, "maximum":2147483647}},
    "spatial_region": {
      "type":"object", "additionalProperties":false, "required":["min","max"],
      "properties":{"min":{"$ref":"#/$defs/spatial_coordinate"}, "max":{"$ref":"#/$defs/spatial_coordinate"}},
      "description":"Inclusive signed map coordinates. Runtime rejects any minimum greater than its corresponding maximum."
    },
    "spatial_geometry": {"oneOf":[
      {"type":"object", "additionalProperties":false, "required":["kind","field"], "properties":{"kind":{"const":"point"}, "field":{"$ref":"#/$defs/name"}}},
      {"type":"object", "additionalProperties":false, "required":["kind","min_field","max_field"], "properties":{"kind":{"const":"cuboid"}, "min_field":{"$ref":"#/$defs/name"}, "max_field":{"$ref":"#/$defs/name"}}}
    ]},
    "entity_kind": {"oneOf": [
      {"enum": ["fortress", "unit", "item", "building", "job", "work_order", "stockpile", "zone", "burrow", "squad", "military_order", "tile_feature", "plant", "creature", "historical_figure", "civilization", "announcement", "syndrome"]},
      {"type": "string", "pattern": "^other:.+$", "maxLength": 128}
    ]},
    "edge_kind": {"oneOf": [
      {"enum": ["located_at", "contained_in", "assigned_to", "member_of", "performs", "requires", "produces", "uses", "supports", "threatens", "ordered_by", "parent_of"]},
      {"type": "string", "pattern": "^custom:.+$", "maxLength": 128}
    ]},
    "relation_selector": {
      "type":"object", "additionalProperties":false, "required":["edge_kinds"],
      "properties":{
        "edge_kinds":{"type":"array", "items":{"$ref":"#/$defs/edge_kind"}, "minItems":1, "maxItems":32},
        "direction":{"anyOf":[{"enum":["outgoing","incoming","undirected"]},{"type":"null"}]},
        "target_kinds":{"type":"array", "items":{"$ref":"#/$defs/entity_kind"}, "maxItems":32},
        "target_ids":{"type":"array", "items":{"$ref":"#/$defs/entity_id"}, "maxItems":64},
        "where":{"anyOf":[{"$ref":"#/$defs/filter"},{"type":"null"}]}
      },
      "description":"Positive one-hop relationship selection. Outgoing is the default; target means the opposite endpoint in the selected direction. Empty target selectors include all recorded endpoints. Missing endpoint records and unavailable target filter facts remain Unknown. Negated relation existence is unsupported without complete relation-domain evidence."
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["fortress_id", "epoch", "sequence", "game_tick", "state_hash"],
      "properties": {
        "fortress_id": {"$ref": "#/$defs/entity_id"},
        "epoch": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "game_tick": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "literal": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "null"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "bool"}, "value": {"type": "boolean"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "i64"}, "value": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "u64"}, "value": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "text"}, "value": {"type": "string", "maxLength": 65536}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "fixed"}, "value": {"type": "object", "additionalProperties": false, "required": ["units", "scale"], "properties": {"units": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}, "scale": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "coord"}, "value": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {"x": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}, "y": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}, "z": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "entity"}, "value": {"$ref": "#/$defs/entity_id"}}}
    ]},
    "filter": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": {"op": {"const": "all"}, "args": {"type": "array", "items": {"$ref": "#/$defs/filter"}, "maxItems": 4096, "minItems": 0}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": {"op": {"const": "any"}, "args": {"type": "array", "items": {"$ref": "#/$defs/filter"}, "maxItems": 4096, "minItems": 0}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "arg"], "properties": {"op": {"const": "not"}, "arg": {"$ref": "#/$defs/filter"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "field", "comparison", "value"], "properties": {"op": {"const": "compare"}, "field": {"$ref": "#/$defs/name"}, "comparison": {"enum": ["eq", "ne", "lt", "le", "gt", "ge"]}, "value": {"$ref": "#/$defs/literal"}}}
    ]},
    "group_by": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "entity_kind"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "field"], "properties": {"kind": {"const": "field"}, "field": {"$ref": "#/$defs/name"}}}
    ]},
    "numeric_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "numeric_type",
        "direction"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/name"
        },
        "numeric_type": {
          "enum": [
            "i64",
            "u64",
            "fixed"
          ]
        },
        "scale": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "enum": [
            "ascending",
            "descending"
          ]
        },
        "max_age_ticks": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "numeric_type": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "scale"
            ],
            "properties": {
              "scale": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          },
          "else": {
            "properties": {
              "scale": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "numeric_metric": {
      "type": "object", "additionalProperties": false, "required": ["name", "field", "numeric_type"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "field": {"$ref": "#/$defs/name"}, "numeric_type": {"enum": ["i64", "u64", "fixed"]}, "scale": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 4294967295}, {"type": "null"}]}},
      "allOf": [{"if": {"properties": {"numeric_type": {"const": "fixed"}}}, "then": {"required": ["scale"], "properties": {"scale": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}, "else": {"properties": {"scale": {"type": "null"}}}}]
    },
    "baseline": {"type":"string", "pattern":"^qb1:[0-9a-f]{64}$", "description":"Session-owned immutable baseline handle, never mutation authority."},
    "capture_selection": {
      "type":"object", "additionalProperties":false, "required":["kind"],
      "properties": {
        "kind":{"const":"entities"}, "kinds":{"type":"array", "items":{"$ref":"#/$defs/entity_kind"}, "maxItems":32},
        "where":{"anyOf":[{"$ref":"#/$defs/filter"},{"type":"null"}]},
        "fields":{"type":"array", "items":{"$ref":"#/$defs/name"}, "maxItems":32},
        "order":{"anyOf":[{"enum":["id_ascending","id_descending","label_ascending","revision_descending"]},{"type":"null"}]}
      }
    },
    "watch_handle": {"type":"string","pattern":"^watch:[0-9a-f]{64}$"},
    "watch_literal": {"oneOf":[{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"null"}}},{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"bool"},"value":{"type":"boolean"}}},{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"i64"},"value":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807}}},{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"u64"},"value":{"type":"integer","minimum":0,"maximum":18446744073709551615}}},{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"text"},"value":{"type":"string","minLength":0,"maxLength":1024,"pattern":"^[^\u0000]*$"}}},{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"fixed"},"value":{"type":"object","additionalProperties":false,"required":["units","scale"],"properties":{"units":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807},"scale":{"type":"integer","minimum":0,"maximum":4294967295}}}}}]},
    "watch_condition": {"description":"Runtime enforces depth <=8 and at most 64 shared success/failure nodes. Only current observed DFHack fields can establish field conditions. Missing facts and type mismatches remain unknown.","oneOf":[{"type":"object","additionalProperties":false,"required":["op","entity_id","generation","field","comparison","value"],"properties":{"op":{"const":"field"},"entity_id":{"$ref":"#/$defs/entity_id"},"generation":{"type":"integer","minimum":1,"maximum":4294967295},"field":{"$ref":"#/$defs/name"},"comparison":{"enum":["eq","ne","lt","le","gt","ge"]},"value":{"$ref":"#/$defs/watch_literal"}}},{"type":"object","additionalProperties":false,"required":["op","value"],"properties":{"op":{"const":"paused"},"value":{"type":"boolean"}}},{"type":"object","additionalProperties":false,"required":["op","value"],"properties":{"op":{"const":"tick_at_least"},"value":{"type":"integer","minimum":0,"maximum":18446744073709551615}}},{"type":"object","additionalProperties":false,"required":["op","args"],"properties":{"op":{"const":"all"},"args":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/watch_condition"}}}},{"type":"object","additionalProperties":false,"required":["op","args"],"properties":{"op":{"const":"any"},"args":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/watch_condition"}}}},{"type":"object","additionalProperties":false,"required":["op","arg"],"properties":{"op":{"const":"not"},"arg":{"$ref":"#/$defs/watch_condition"}}}]},
    "query": {"oneOf": [
      {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": {"const": "entities"}, "kinds": {"type": "array", "items": {"$ref": "#/$defs/entity_kind"}, "maxItems": 32, "minItems": 0},
          "where": {"anyOf": [{"$ref": "#/$defs/filter"}, {"type": "null"}]}, "fields": {"type": "array", "items": {"$ref": "#/$defs/name"}, "maxItems": 32, "minItems": 0},
          "order": {"anyOf": [{"enum": ["id_ascending", "id_descending", "label_ascending", "revision_descending"]}, {"type": "null"}]},
          "limit": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 512}, {"type": "null"}]}, "continuation": {"anyOf": [{"type": "string", "maxLength": 256}, {"type": "null"}]}
        }
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind","region","geometry"],
        "properties":{
          "kind":{"const":"spatial_entities"}, "region":{"$ref":"#/$defs/spatial_region"}, "geometry":{"$ref":"#/$defs/spatial_geometry"},
          "relation":{"anyOf":[{"enum":["intersects","within","contains"]},{"type":"null"}]},
          "kinds":{"type":"array", "items":{"$ref":"#/$defs/entity_kind"}, "maxItems":32},
          "fields":{"type":"array", "items":{"$ref":"#/$defs/name"}, "maxItems":32},
          "where":{"anyOf":[{"$ref":"#/$defs/filter"},{"type":"null"}]},
          "order":{"anyOf":[{"enum":["id_ascending","id_descending"]},{"type":"null"}]},
          "limit":{"anyOf":[{"type":"integer", "minimum":1, "maximum":128},{"type":"null"}]},
          "continuation":{"anyOf":[{"type":"string", "maxLength":256},{"type":"null"}]}
        },
        "description":"Bounded inclusive point/cuboid selection from explicitly named Known coordinate facts. Intersects is the default; within means the entity geometry is contained by the region, contains means it contains the region. Distinct cuboid fields are required. Unavailable, contradictory, mistyped, future or inverted geometry is counted as unknown, never outside. Facts retain provenance. Continuations bind the complete source, session and selection; page width may change. No terrain, path, occupancy completeness or effect authority is inferred."
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "entity_id", "generation"],
        "properties": {"kind": {"const": "inspect"}, "entity_id": {"$ref": "#/$defs/entity_id"}, "generation": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "fields": {"type": "array", "items": {"$ref": "#/$defs/name"}, "maxItems": 32, "minItems": 0}}
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind","relation"],
        "properties":{
          "kind":{"const":"related_entities"}, "relation":{"$ref":"#/$defs/relation_selector"},
          "kinds":{"type":"array", "items":{"$ref":"#/$defs/entity_kind"}, "maxItems":32},
          "where":{"anyOf":[{"$ref":"#/$defs/filter"},{"type":"null"}]},
          "fields":{"type":"array", "items":{"$ref":"#/$defs/name"}, "maxItems":32},
          "order":{"anyOf":[{"enum":["id_ascending","id_descending"]},{"type":"null"}]},
          "limit":{"anyOf":[{"type":"integer", "minimum":1, "maximum":128},{"type":"null"}]},
          "continuation":{"anyOf":[{"type":"string", "maxLength":256},{"type":"null"}]}
        },
        "description":"Select each source entity once when at least one recorded edge joins it to a target satisfying the relation selector. Source and target filters are independent and three-valued. Results preserve source field provenance, exact edge revisions and current source endpoint generations, with at most four witnesses per row and an explicit omitted count. Complete-source scan admission precedes selection; continuations bind the session, full anchor, both filters and every selector. No observed match never proves absence outside the projection or authorizes an effect."
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "roots", "max_depth"],
        "properties": {
          "kind": {"const": "traverse"}, "roots": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}, "maxItems": 64, "minItems": 1},
          "edge_kinds": {"type": "array", "items": {"$ref": "#/$defs/edge_kind"}, "maxItems": 32, "minItems": 0}, "direction": {"anyOf": [{"enum": ["outgoing", "incoming", "undirected"]}, {"type": "null"}]},
          "max_depth": {"type": "integer", "minimum": 0, "maximum": 1024}, "target": {"anyOf": [{"$ref": "#/$defs/entity_id"}, {"type": "null"}]}
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "edge_kinds"],
        "properties": {"kind": {"const": "dependencies"}, "edge_kinds": {"type": "array", "items": {"$ref": "#/$defs/edge_kind"}, "maxItems": 32, "minItems": 1}}
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": {"const": "aggregate"}, "kinds": {"type": "array", "items": {"$ref": "#/$defs/entity_kind"}, "maxItems": 32, "minItems": 0},
          "where": {"anyOf": [{"$ref": "#/$defs/filter"}, {"type": "null"}], "description": "Only True rows contribute. Unavailable filter facts remain Unknown and are counted separately from False in selection coverage."},
          "group_by": {"anyOf": [{"$ref": "#/$defs/group_by"}, {"type": "null"}]}, "metrics": {"type": "array", "items": {"$ref": "#/$defs/numeric_metric"}, "maxItems": 16, "minItems": 0},
          "max_groups": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 128}, {"type": "null"}]}
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "text"],
        "properties": {
          "kind": {"const": "search"}, "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\u0000]+$"},
          "kinds": {"type": "array", "items": {"$ref": "#/$defs/entity_kind"}, "maxItems": 32, "minItems": 0}, "text_fields": {"type": "array", "items": {"$ref": "#/$defs/name"}, "maxItems": 16, "minItems": 0},
          "include_labels": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}, "match_mode": {"anyOf": [{"enum": ["all", "any"]}, {"type": "null"}]},
          "limit": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 128}, {"type": "null"}]}, "continuation": {"anyOf": [{"type": "string", "maxLength": 256}, {"type": "null"}]}
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": {"const": "events"},
          "from_tick": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 18446744073709551615}, {"type": "null"}]},
          "through_tick": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 18446744073709551615}, {"type": "null"}]},
          "kinds": {"type": "array", "items": {"$ref": "#/$defs/name"}, "maxItems": 32, "description": "Exact canonical event kind names, including custom names; empty selects every retained kind."},
          "subjects": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}, "maxItems": 64, "description": "Exact historical subject IDs. Empty also includes subjectless events; this does not resolve a current entity generation."},
          "fields": {"type": "array", "items": {"$ref": "#/$defs/name"}, "maxItems": 32},
          "order": {"anyOf": [{"enum": ["tick_ascending", "tick_descending"]}, {"type": "null"}]},
          "limit": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 128}, {"type": "null"}]},
          "continuation": {"anyOf": [{"type": "string", "maxLength": 256}, {"type": "null"}]}
        },
        "description": "Inclusive tick window over the exact retained canonical event projection; defaults to tick zero through the source tick, ascending tick then EventId, four rows and no additional fields. The runtime rejects reversed/future windows. Every selector and the complete anchor/session bind continuation; page width may change. Retention completeness, per-field provenance and source authenticity remain unestablished, and results cannot authorize effects."
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind","key","select","max_game_ticks"],
        "properties":{"kind":{"const":"capture"}, "key":{"type":"string", "pattern":"^[A-Za-z0-9._-]{1,64}$"},
          "select":{"$ref":"#/$defs/capture_selection"}, "max_game_ticks":{"type":"integer", "minimum":1, "maximum":18446744073709551615}},
        "description":"Capture a complete selected result of at most 256 rows, bounded by the session lifetime budget. No bridge refresh occurs."
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind","baseline"],
        "properties":{"kind":{"const":"changes"}, "baseline":{"$ref":"#/$defs/baseline"},
          "limit":{"anyOf":[{"type":"integer", "minimum":1, "maximum":256},{"type":"null"}]},
          "continuation":{"anyOf":[{"type":"string", "maxLength":128},{"type":"null"}]}},
        "description":"Compare the current published projection with an immutable baseline. Refresh via observe/wait before the first page, never between continuation pages."
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind"],
        "properties":{"kind":{"const":"baselines"}}, "description":"List this session's retained baselines, including expired or epoch-invalidated entries."
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind","baseline"],
        "properties":{"kind":{"const":"release_baseline"}, "baseline":{"$ref":"#/$defs/baseline"}},
        "description":"Explicitly release process-local baseline storage. Does not change any game, save, or action state."
      },
      {"type":"object","additionalProperties":false,"required":["kind","key","condition","deadline_tick"],"properties":{"kind":{"const":"watch"},"key":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[^\u0000]*$"},"label":{"anyOf":[{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\u0000]*$"},{"type":"null"}]},"condition":{"$ref":"#/$defs/watch_condition"},"failure_condition":{"anyOf":[{"$ref":"#/$defs/watch_condition"},{"type":"null"}]},"deadline_tick":{"type":"integer","minimum":0,"maximum":18446744073709551615},"poll_interval_ticks":{"anyOf":[{"type":"integer","minimum":1,"maximum":1000000},{"type":"null"}]},"stable_observations":{"anyOf":[{"type":"integer","minimum":1,"maximum":64},{"type":"null"}]}},"description":"Register an idempotent session-owned foreground watch. Deadline must be future and within the session game-tick budget. Default stability is two distinct due observations, cadence one tick. No bridge read or game effect."},
      {"type":"object","additionalProperties":false,"required":["kind","watch"],"properties":{"kind":{"const":"poll_watch"},"watch":{"$ref":"#/$defs/watch_handle"}},"description":"Evaluate the current published snapshot without a bridge read. Repeated anchors cannot manufacture stability."},
      {"type":"object","additionalProperties":false,"required":["kind","watch"],"properties":{"kind":{"const":"await_watch"},"watch":{"$ref":"#/$defs/watch_handle"}},"description":"Validate ownership and the pre-refresh expected_anchor, perform at most one bounded read-only observation, then evaluate. A nonterminal watch requires Query and Observe authority. Does not unpause or sleep; terminal watches do not refresh."},
      {"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"watches"}},"description":"List this session's retained watches without evaluating them. Local metadata remains available when the bridge is poisoned."},
      {"type":"object","additionalProperties":false,"required":["kind","watch"],"properties":{"kind":{"const":"cancel_watch"},"watch":{"$ref":"#/$defs/watch_handle"}},"description":"Cancel only local foreground watch bookkeeping, without game effects or bridge I/O. Terminal evidence is immutable."},
      {"type":"object","additionalProperties":false,"required":["kind","watch"],"properties":{"kind":{"const":"release_watch"},"watch":{"$ref":"#/$defs/watch_handle"}},"description":"Release terminal watch storage. Nonterminal watches must be cancelled first. No game or save effects."},
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "order_by"
        ],
        "properties": {
          "kind": {
            "const": "ranked_entities"
          },
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/entity_kind"
            },
            "maxItems": 32
          },
          "where": {
            "anyOf": [
              {
                "$ref": "#/$defs/filter"
              },
              {
                "type": "null"
              }
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/name"
            },
            "maxItems": 32
          },
          "order_by": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/numeric_order"
            }
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "continuation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "description": "Select entities by one to three exact typed numeric facts, lexicographically ordered with ascending entity ID as the final tie-break. Each field may appear once. Fixed values require an exact scale. Missing, unavailable, future, over-age or mistyped ordering facts remain Unknown and are excluded separately from filter failures. The bounded heap retains at most the requested page. Full-source admission precedes ranking; continuations bind every selector, ordering rule, session and source anchor. Ranked facts retain provenance and never authorize mutation."
