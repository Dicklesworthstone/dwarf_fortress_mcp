{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dfmcp:query:1",
  "title": "Structured canonical query envelope",
  "description": "Value of the query argument on protocol-1.1 fortress.query. Omit top-level mode/limit/continuation. Runtime additionally checks UTF-8 byte lengths, bounded shapes and work, unique metric names, group cardinality, exact anchors, authorization and complete response budgets. Capture/changes are bounded foreground endpoint comparisons, not background watchers or durable history.",
  "type": "object", "additionalProperties": false, "required": ["schema", "query"],
  "properties": {
    "schema": {"const": "dfmcp.query/1"},
    "expected_anchor": {"anyOf": [{"$ref": "#/$defs/anchor"}, {"type": "null"}]},
    "query": {"$ref": "#/$defs/query"}
  },
  "$defs": {
    "entity_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$", "description": "Canonical positive decimal u64; the runtime also checks numeric overflow."},
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\u0000]+$"},
    "entity_kind": {"oneOf": [
      {"enum": ["fortress", "unit", "item", "building", "job", "work_order", "stockpile", "zone", "burrow", "squad", "military_order", "tile_feature", "plant", "creature", "historical_figure", "civilization", "announcement", "syndrome"]},
      {"type": "string", "pattern": "^other:.+$", "maxLength": 128}
    ]},
    "edge_kind": {"oneOf": [
      {"enum": ["located_at", "contained_in", "assigned_to", "member_of", "performs", "requires", "produces", "uses", "supports", "threatens", "ordered_by", "parent_of"]},
      {"type": "string", "pattern": "^custom:.+$", "maxLength": 128}
    ]},
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["fortress_id", "epoch", "sequence", "game_tick", "state_hash"],
      "properties": {
        "fortress_id": {"$ref": "#/$defs/entity_id"},
        "epoch": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "game_tick": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "literal": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "null"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "bool"}, "value": {"type": "boolean"}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "i64"}, "value": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "u64"}, "value": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "text"}, "value": {"type": "string", "maxLength": 65536}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "fixed"}, "value": {"type": "object", "additionalProperties": false, "required": ["units", "scale"], "properties": {"units": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}, "scale": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "coord"}, "value": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {"x": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}, "y": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}, "z": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "entity"}, "value": {"$ref": "#/$defs/entity_id"}}}
    ]},
    "filter": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": {"op": {"const": "all"}, "args": {"type": "array", "items": {"$ref": "#/$defs/filter"}, "maxItems": 4096, "minItems": 0}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": {"op": {"const": "any"}, "args": {"type": "array", "items": {"$ref": "#/$defs/filter"}, "maxItems": 4096, "minItems": 0}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "arg"], "properties": {"op": {"const": "not"}, "arg": {"$ref": "#/$defs/filter"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "field", "comparison", "value"], "properties": {"op": {"const": "compare"}, "field": {"$ref": "#/$defs/name"}, "comparison": {"enum": ["eq", "ne", "lt", "le", "gt", "ge"]}, "value": {"$ref": "#/$defs/literal"}}}
    ]},
    "group_by": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "entity_kind"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "field"], "properties": {"kind": {"const": "field"}, "field": {"$ref": "#/$defs/name"}}}
    ]},
    "numeric_metric": {
      "type": "object", "additionalProperties": false, "required": ["name", "field", "numeric_type"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "field": {"$ref": "#/$defs/name"}, "numeric_type": {"enum": ["i64", "u64", "fixed"]}, "scale": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 4294967295}, {"type": "null"}]}},
      "allOf": [{"if": {"properties": {"numeric_type": {"const": "fixed"}}}, "then": {"required": ["scale"], "properties": {"scale": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}, "else": {"properties": {"scale": {"type": "null"}}}}]
    },
    "baseline": {"type":"string", "pattern":"^qb1:[0-9a-f]{64}$", "description":"Session-owned immutable baseline handle, never mutation authority."},
    "capture_selection": {
      "type":"object", "additionalProperties":false, "required":["kind"],
      "properties": {
        "kind":{"const":"entities"}, "kinds":{"type":"array", "items":{"$ref":"#/$defs/entity_kind"}, "maxItems":32},
        "where":{"anyOf":[{"$ref":"#/$defs/filter"},{"type":"null"}]},
        "fields":{"type":"array", "items":{"$ref":"#/$defs/name"}, "maxItems":32},
        "order":{"anyOf":[{"enum":["id_ascending","id_descending","label_ascending","revision_descending"]},{"type":"null"}]}
      }
    },
    "query": {"oneOf": [
      {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": {"const": "entities"}, "kinds": {"type": "array", "items": {"$ref": "#/$defs/entity_kind"}, "maxItems": 32, "minItems": 0},
          "where": {"anyOf": [{"$ref": "#/$defs/filter"}, {"type": "null"}]}, "fields": {"type": "array", "items": {"$ref": "#/$defs/name"}, "maxItems": 32, "minItems": 0},
          "order": {"anyOf": [{"enum": ["id_ascending", "id_descending", "label_ascending", "revision_descending"]}, {"type": "null"}]},
          "limit": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 512}, {"type": "null"}]}, "continuation": {"anyOf": [{"type": "string", "maxLength": 256}, {"type": "null"}]}
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "entity_id", "generation"],
        "properties": {"kind": {"const": "inspect"}, "entity_id": {"$ref": "#/$defs/entity_id"}, "generation": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "fields": {"type": "array", "items": {"$ref": "#/$defs/name"}, "maxItems": 32, "minItems": 0}}
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "roots", "max_depth"],
        "properties": {
          "kind": {"const": "traverse"}, "roots": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}, "maxItems": 64, "minItems": 1},
          "edge_kinds": {"type": "array", "items": {"$ref": "#/$defs/edge_kind"}, "maxItems": 32, "minItems": 0}, "direction": {"anyOf": [{"enum": ["outgoing", "incoming", "undirected"]}, {"type": "null"}]},
          "max_depth": {"type": "integer", "minimum": 0, "maximum": 1024}, "target": {"anyOf": [{"$ref": "#/$defs/entity_id"}, {"type": "null"}]}
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "edge_kinds"],
        "properties": {"kind": {"const": "dependencies"}, "edge_kinds": {"type": "array", "items": {"$ref": "#/$defs/edge_kind"}, "maxItems": 32, "minItems": 1}}
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": {"const": "aggregate"}, "kinds": {"type": "array", "items": {"$ref": "#/$defs/entity_kind"}, "maxItems": 32, "minItems": 0},
          "group_by": {"anyOf": [{"$ref": "#/$defs/group_by"}, {"type": "null"}]}, "metrics": {"type": "array", "items": {"$ref": "#/$defs/numeric_metric"}, "maxItems": 16, "minItems": 0},
          "max_groups": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 128}, {"type": "null"}]}
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "text"],
        "properties": {
          "kind": {"const": "search"}, "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\u0000]+$"},
          "kinds": {"type": "array", "items": {"$ref": "#/$defs/entity_kind"}, "maxItems": 32, "minItems": 0}, "text_fields": {"type": "array", "items": {"$ref": "#/$defs/name"}, "maxItems": 16, "minItems": 0},
          "include_labels": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}, "match_mode": {"anyOf": [{"enum": ["all", "any"]}, {"type": "null"}]},
          "limit": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 128}, {"type": "null"}]}, "continuation": {"anyOf": [{"type": "string", "maxLength": 256}, {"type": "null"}]}
        }
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind","key","select","max_game_ticks"],
        "properties":{"kind":{"const":"capture"}, "key":{"type":"string", "pattern":"^[A-Za-z0-9._-]{1,64}$"},
          "select":{"$ref":"#/$defs/capture_selection"}, "max_game_ticks":{"type":"integer", "minimum":1, "maximum":18446744073709551615}},
        "description":"Capture a complete selected result of at most 256 rows, bounded by the session lifetime budget. No bridge refresh occurs."
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind","baseline"],
        "properties":{"kind":{"const":"changes"}, "baseline":{"$ref":"#/$defs/baseline"},
          "limit":{"anyOf":[{"type":"integer", "minimum":1, "maximum":256},{"type":"null"}]},
          "continuation":{"anyOf":[{"type":"string", "maxLength":128},{"type":"null"}]}},
        "description":"Compare the current published projection with an immutable baseline. Refresh via observe/wait before the first page, never between continuation pages."
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind"],
        "properties":{"kind":{"const":"baselines"}}, "description":"List this session's retained baselines, including expired or epoch-invalidated entries."
      },
      {
        "type":"object", "additionalProperties":false, "required":["kind","baseline"],
        "properties":{"kind":{"const":"release_baseline"}, "baseline":{"$ref":"#/$defs/baseline"}},
        "description":"Explicitly release process-local baseline storage. Does not change any game, save, or action state."
      }
    ]}
  }
}
