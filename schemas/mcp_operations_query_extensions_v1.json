{
  "schema_version": "dfmcp.operations-query-extensions/1",
  "description": "Merged only into operations/1.3 schema discovery. Runtime also checks UTF-8 byte sizes, unique keys, canonical integer IDs, work and response bounds, exact anchors and Query authority.",
  "definitions": {
    "operations_focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "generation"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "operations_material_demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "units",
        "item_types"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "item_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\u0000]+$"
          }
        },
        "subtype": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "material_type": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "material_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "material_index"
            ],
            "properties": {
              "material_index": {
                "type": "integer"
              }
            }
          },
          "then": {
            "required": [
              "material_type"
            ],
            "properties": {
              "material_type": {
                "type": "integer",
                "minimum": -1,
                "maximum": 2147483647
              }
            }
          }
        }
      ]
    }
  },
  "queries": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "production_diagnosis"
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/operations_focus"
            },
            {
              "type": "null"
            }
          ]
        },
        "holder": {
          "anyOf": [
            {
              "$ref": "#/$defs/operations_focus"
            },
            {
              "type": "null"
            }
          ]
        },
        "include_clear_jobs": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^op1:[1-9][0-9]{0,5}:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_work": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Inspect joined native job, holder, attached-item and container conditions. Findings do not prove causal blockers or readiness."
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "quantity_unit",
        "demands"
      ],
      "properties": {
        "kind": {
          "const": "inventory_plan"
        },
        "quantity_unit": {
          "const": "stack_units"
        },
        "demands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/operations_material_demand"
          }
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^op1:[1-9][0-9]{0,5}:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_work": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Exact integral allocation for declared interchangeable stack-unit requests under a conservative observed-supply policy. Not native requirement matching, a reservation, or an executable effect plan."
    }
  ]
}
