{
  "schema_version": "dfmcp.operations-query-extensions/1",
  "description": "Merged into coherent operations schema discovery, including operations/1.3 and paged operations/1.4. Runtime also checks UTF-8 byte sizes, unique keys, canonical integer IDs, work and response bounds, exact anchors and Query authority.",
  "definitions": {
    "operations_focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "generation"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "operations_material_demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "units",
        "item_types"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "item_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\u0000]+$"
          }
        },
        "subtype": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "material_type": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "material_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "material_index"
            ],
            "properties": {
              "material_index": {
                "type": "integer"
              }
            }
          },
          "then": {
            "required": [
              "material_type"
            ],
            "properties": {
              "material_type": {
                "type": "integer",
                "minimum": -1,
                "maximum": 2147483647
              }
            }
          }
        }
      ]
    },
    "operations_furniture_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "target"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,48}$"
        },
        "kind": {
          "enum": [
            "bed",
            "chair",
            "table"
          ]
        },
        "target": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 32766
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 32766
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            }
          ],
          "items": false
        },
        "after": {
          "type": "array",
          "maxItems": 31,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,48}$"
          }
        },
        "material": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                {
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 2147483647
                }
              ],
              "items": false
            },
            {
              "type": "null"
            }
          ]
        },
        "subtype": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "max_distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65532,
          "default": 65532
        }
      },
      "description": "One exact furniture target. Runtime requires unique names and targets, resolved acyclic dependencies, and canonical normalized request bytes at most 16 KiB. Distance is same-level Manhattan geometry, not path access."
    }
  },
  "queries": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "production_diagnosis"
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/operations_focus"
            },
            {
              "type": "null"
            }
          ]
        },
        "holder": {
          "anyOf": [
            {
              "$ref": "#/$defs/operations_focus"
            },
            {
              "type": "null"
            }
          ]
        },
        "include_clear_jobs": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^op1:[1-9][0-9]{0,5}:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_work": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Inspect joined native job, holder, attached-item and container conditions. Findings do not prove causal blockers or readiness."
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "quantity_unit",
        "demands"
      ],
      "properties": {
        "kind": {
          "const": "inventory_plan"
        },
        "quantity_unit": {
          "const": "stack_units"
        },
        "demands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/operations_material_demand"
          }
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^op1:[1-9][0-9]{0,5}:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_work": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Exact integral allocation for declared interchangeable stack-unit requests under a conservative observed-supply policy. Not native requirement matching, a reservation, or an executable effect plan."
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "world_folder",
        "site",
        "slots"
      ],
      "properties": {
        "kind": {
          "const": "furniture_allocation"
        },
        "world_folder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\u0000]+$",
          "description": "Must equal this capture's native world folder; runtime ceiling is 512 UTF-8 bytes."
        },
        "site": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/operations_furniture_slot"
          }
        },
        "excluded_items": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483646
          }
        },
        "maximum_work": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Allocate distinct observed ground bed/chair/table items globally, minimizing total same-level Manhattan distance then the item-ID vector in lexical slot-name order. Returns one complete dfmcp.furniture-plan/1 artifact or an exact candidate-subset shortage; no partial plan or pagination. Source-bound native IDs still require fresh exact placement review. No reservations, game effects or prepared MCP mutation plan. The full response must fit after required Agent Turn and active-work metadata."
    }
  ]
}
