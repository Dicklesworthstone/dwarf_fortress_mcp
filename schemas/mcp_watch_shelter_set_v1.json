{
  "$comment": "Whole named spatial/1.8 shelter condition, not mutation or source authority. Rust additionally requires canonical numeric citizen and cuboid ordering, unique citizen IDs across generations, the spatial namespace, u64 range, non-reversed regions and at most 262144 summed tiles. Complete request shape and watch budgets also apply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op",
    "citizens",
    "shelters"
  ],
  "properties": {
    "op": {
      "const": "shelter_set"
    },
    "citizens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "generation"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$",
            "not": {
              "pattern": "[^0-9]"
            }
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        }
      }
    },
    "shelters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "min": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            }
          },
          "max": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            }
          }
        }
      }
    }
  }
}
