{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwarf-fortress-mcp.dev/schemas/lab_wait.schema.json",
  "title": "Laboratory fortress_wait arguments",
  "description": "One existing tool supports ordinary duration-based waiting, one exact original plan, an explicit set of complete originals, one condition watch, or an explicit set of retained laboratory watches. Current ownership, grants, complete source bounds and complete response admission remain binding.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{32}$",
      "description": "Optional wire selector resolved by the existing laboratory session resolver; supply the canonical owning session identifier returned by fortress_open_session."
    },
    "max_game_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 18446744073709551615,
      "description": "Total time cap. Omitted/null means zero. Positive ticks require ControlClock. The world remains paused unless a separately authorized operation unpauses it."
    },
    "plan_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "One exact session-owned or verified durable original committed plan; mutually exclusive with non-null plan_digests, watch_id or watch_ids."
    },
    "watch_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^watch:[0-9a-f]{64}$",
      "description": "One retained laboratory watch handle. Samples its immutable original condition at bounded published frontiers. Mutually exclusive with non-null plan_digest, plan_digests or watch_ids."
    },
    "watch_ids": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^watch:[0-9a-f]{64}$"
      },
      "description": "One explicit set of one to eight unique owned laboratory watch handles. Every published frontier samples the exact set atomically, respecting each unfinished member's cadence and deadline. Mutually exclusive with non-null plan_digest, plan_digests or watch_id."
    },
    "watch_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "all_satisfied",
        "any_satisfied",
        null
      ],
      "description": "Group policy for watch_ids only. Omitted/null means all_satisfied. Attention takes precedence over group success. Policies aggregate retained outcomes, including historical terminals, without claiming current simultaneous truth."
    },
    "plan_digests": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "One explicit set of one to eight distinct session-owned or verified durable original plans. Different aliases resolving to the same original are also refused. Each frontier inspects the complete set at one current snapshot and clips time to every selected original reserve horizon. Mutually exclusive with non-null plan_digest, watch_id or watch_ids."
    },
    "plan_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "all",
        "any",
        null
      ],
      "description": "Group policy for plan_digests only. Omitted/null means all. All requires every selected original to be complete at the same current frontier; any requires at least one. Current consumable goals are reevaluated, and any exceptional member outcome takes precedence over group success."
    },
    "as_task": {
      "type": "boolean",
      "description": "Modern negotiated Tasks projection for one exact original plan or one explicit original-plan set. Requires an explicit session and omitted/null/zero max_game_ticks. False or omitted preserves foreground wait. Task observation never advances time, polls actions, loads archives or captures reserve endpoints; cancellation stops only the monitor."
    }
  },
  "examples": [
    {
      "session_id": "00000000000000000000000000000001",
      "max_game_ticks": 200,
      "watch_id": "watch:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "session_id": "00000000000000000000000000000001",
      "max_game_ticks": 0,
      "watch_id": "watch:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    },
    {
      "session_id": "00000000000000000000000000000001",
      "max_game_ticks": 200,
      "watch_ids": [
        "watch:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "watch:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ],
      "watch_policy": "all_satisfied"
    },
    {
      "session_id": "00000000000000000000000000000001",
      "max_game_ticks": 2000,
      "plan_digests": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ],
      "plan_policy": "all"
    },
    {
      "session_id": "00000000000000000000000000000001",
      "max_game_ticks": 0,
      "plan_digests": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ],
      "plan_policy": "all",
      "as_task": true
    }
  ],
  "allOf": [
    {
      "not": {
        "required": [
          "plan_digest",
          "plan_digests"
        ],
        "properties": {
          "plan_digest": {
            "type": "string"
          },
          "plan_digests": {
            "type": "array"
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "plan_digest",
          "watch_id"
        ],
        "properties": {
          "plan_digest": {
            "type": "string"
          },
          "watch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "plan_digest",
          "watch_ids"
        ],
        "properties": {
          "plan_digest": {
            "type": "string"
          },
          "watch_ids": {
            "type": "array"
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "plan_digests",
          "watch_id"
        ],
        "properties": {
          "plan_digests": {
            "type": "array"
          },
          "watch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "plan_digests",
          "watch_ids"
        ],
        "properties": {
          "plan_digests": {
            "type": "array"
          },
          "watch_ids": {
            "type": "array"
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "watch_id",
          "watch_ids"
        ],
        "properties": {
          "watch_id": {
            "type": "string"
          },
          "watch_ids": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "watch_policy"
        ],
        "properties": {
          "watch_policy": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "watch_ids"
        ],
        "properties": {
          "watch_ids": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "plan_policy"
        ],
        "properties": {
          "plan_policy": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "plan_digests"
        ],
        "properties": {
          "plan_digests": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "as_task"
        ],
        "properties": {
          "as_task": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "max_game_ticks": {
            "enum": [
              0,
              null
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "plan_digest"
            ],
            "properties": {
              "plan_digest": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "plan_digests"
            ],
            "properties": {
              "plan_digests": {
                "type": "array"
              }
            }
          }
        ]
      }
    }
  ]
}
