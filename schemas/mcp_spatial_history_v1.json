{
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": {"const": "history"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 64},
        "continuation": {"oneOf": [
          {"type": "null"},
          {"type": "string", "maxLength": 128, "pattern": "^sh1:[1-9][0-9]*:[0-9a-f]{64}$"}
        ]}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "record", "record_digest", "query"],
      "properties": {
        "kind": {"const": "historical_query"},
        "record": {"type": "integer", "minimum": 1, "maximum": 4096},
        "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "query": {"allOf": [
          {"$ref": "#/$defs/query"},
          {"type": "object", "required": ["kind"], "properties": {
            "kind": {"enum": ["entities", "inspect", "traverse", "dependencies", "aggregate", "search", "map_route", "spatial_inventory_plan"]}
          }}
        ]}
      }
    }
  ]
}
