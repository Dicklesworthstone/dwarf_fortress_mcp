{
  "$id": "https://dwarf-fortress-mcp.org/schemas/0.1.0/lab_resource_production.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Laboratory production with reviewed finite resource acquisition",
  "description": "Decoded fortress.plan blueprint string. Retains the original output quotas while proposing either acquisition or production from current observed input stock. Intake installs resource_aware_v1; archived sources must name it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["template", "quotas", "acquire_resources"],
  "properties": {
    "template": {"const": "production"},
    "planner": {"const": "resource_aware_v1"},
    "quotas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "minimum"],
        "properties": {
          "item": {"enum": ["DRINK", "FOOD", "BED", "DOOR", "TABLE", "CHAIR"]},
          "minimum": {"type": "integer", "minimum": 0, "maximum": 4294967295}
        }
      }
    },
    "acquire_resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assign_labor": {"type": "boolean", "default": false}
      }
    },
    "orders": {"const": "dependency_preserving_v1"},
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assign_labor": {"type": "boolean", "default": false},
        "workforce": {"const": "complete_project_v1"},
        "workshops": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["building", "location"],
            "dependentRequired": {"min": ["max"], "max": ["min"]},
            "properties": {
              "building": {"enum": ["workshop:Still", "workshop:Kitchen", "workshop:Carpenters"]},
              "location": {"$ref": "#/$defs/coordinate"},
              "min": {"$ref": "#/$defs/coordinate"},
              "max": {"$ref": "#/$defs/coordinate"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
    }
  },
  "$comment": "The Rust parser also checks original duplicate keys, exact integer representations, the 16384-byte request bound, canonical compiler selection, site geometry and closed semantics. Repeated quota tokens use their largest minimum. Only qualified current stock funds production. reserve_until_tick is deliberately unsupported by resource_aware_v1. Every stage needs separate review and commit; continue_goal names a retained parent only."
}
