{
  "$id": "https://dwarf-fortress-mcp.org/schemas/0.1.0/lab_resource_production.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Laboratory production with reviewed finite resource acquisition",
  "description": "Decoded fortress.plan blueprint string. Retains original output quotas while proposing acquisition or production from observed inputs. Intake selects resource_aware_v1, or resource_reserve_v1 when reserve_until_tick is supplied. Archives retain the exact compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["template", "quotas", "acquire_resources"],
  "properties": {
    "template": {"const": "production"},
    "planner": {"enum": ["resource_aware_v1", "resource_reserve_v1"]},
    "reserve_until_tick": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "quotas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "minimum"],
        "properties": {
          "item": {"enum": ["DRINK", "FOOD", "BED", "DOOR", "TABLE", "CHAIR"]},
          "minimum": {"type": "integer", "minimum": 0, "maximum": 4294967295}
        }
      }
    },
    "acquire_resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assign_labor": {"type": "boolean", "default": false}
      }
    },
    "orders": {"const": "dependency_preserving_v1"},
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assign_labor": {"type": "boolean", "default": false},
        "workforce": {"const": "complete_project_v1"},
        "workshops": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["building", "location"],
            "dependentRequired": {"min": ["max"], "max": ["min"]},
            "properties": {
              "building": {"enum": ["workshop:Still", "workshop:Kitchen", "workshop:Carpenters"]},
              "location": {"$ref": "#/$defs/coordinate"},
              "min": {"$ref": "#/$defs/coordinate"},
              "max": {"$ref": "#/$defs/coordinate"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["reserve_until_tick"]},
      "then": {"properties": {"planner": {"const": "resource_reserve_v1"}}},
      "else": {"properties": {"planner": {"const": "resource_aware_v1"}}}
    }
  ],
  "$defs": {
    "coordinate": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
    }
  },
  "$comment": "The Rust parser additionally checks duplicate keys, exact integers, the 16384-byte bound, compiler identity and geometry. Compilation requires a future reserve tick within one reference year. resource_aware_v1 still rejects horizons; resource_reserve_v1 requires one and retains it through continuation /5. Only observed inputs fund production. Each stage needs separate review and commit."
}
