{
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "from", "to"],
  "description": "Compare source-qualified job indicators at two exact retained spatial/1.8 records in the same observation epoch. Reports original job generation, worker assignment, suspension, same-holder construction stages and attached-item membership. Disappearance does not prove completion and unchanged endpoints do not prove a stall. Read-only; creates no watch, baseline or effect.",
  "properties": {
    "kind": {"const": "historical_job_progress"},
    "from": {
      "type": "object", "additionalProperties": false,
      "required": ["record", "record_digest"],
      "properties": {
        "record": {"type": "integer", "minimum": 1, "maximum": 4096},
        "record_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "to": {
      "type": "object", "additionalProperties": false,
      "required": ["record", "record_digest"],
      "properties": {
        "record": {"type": "integer", "minimum": 1, "maximum": 4096},
        "record_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "job": {
      "description": "Optional original job in the from record. A reused native ID is reported as a different generation, never substituted for this identity.",
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["entity_id", "generation"],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "generation": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "include_unchanged": {"type": ["boolean", "null"], "default": true},
    "limit": {"type": ["integer", "null"], "minimum": 1, "maximum": 128, "default": 4},
    "continuation": {
      "type": ["string", "null"], "maxLength": 128,
      "pattern": "^hjp1:[1-9][0-9]*:[0-9a-f]{64}$",
      "not": {"type": "string", "pattern": "\\s"}
    },
    "max_work": {"type": ["integer", "null"], "minimum": 1, "maximum": 4000000, "default": 4000000}
  }
}
